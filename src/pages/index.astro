---
import ParallaxHero from '../components/ParallaxHero';
import MotionFooter from '../components/MotionFooter';
import SplashScreen from '../components/SplashScreen';
import LookbookSection from '../components/LookbookSection';
import CatalogSection from '../components/CatalogSection';
import { featuredLookbook } from '../data/home';
import '../styles/global.css';
import 'glisse/styles.css';
import '../styles/materials.css';
---

<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F8F6F0" />
    <meta name="description" content="PITALI. Beachwear e fitwear para vestir o seu movimento. Do seu jeito. No seu ritmo." />
    <title>PITALI | Vista seu movimento</title>
    <link rel="icon" type="image/webp" href="/images/pitali-logo.webp" />
    <link rel="preload" as="font" href="/fonts/NeulisAlt-Medium.otf" type="font/otf" crossorigin />
  </head>
  <body>
    <SplashScreen client:load />
    <a class="skip-link" href="#fitwear">Pular apresentação</a>
    <header class="site-header">
      <nav class="desktop-nav" aria-label="Navegação principal">
        <a href="#catalogo">Catálogo</a>
        <a href="#fitwear">Fitwear</a>
        <a href="#universo">Universo Pitali</a>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Abrir menu"><span class="menu-glyph" aria-hidden="true"><i></i><i></i></span><span>Menu</span></summary>
        <nav aria-label="Navegação principal móvel">
          <a href="#inicio">Início <span aria-hidden="true">↗</span></a>
          <a href="#catalogo">Catálogo <span aria-hidden="true">↗</span></a>
          <a href="#fitwear">Fitwear <span aria-hidden="true">↗</span></a>
          <a href="#universo">Universo Pitali <span aria-hidden="true">↗</span></a>
        </nav>
      </details>
      <a class="brand" href="#inicio" aria-label="Pitali, início"><span class="brand-crop"><img src="/images/pitali-wordmark-transparent.webp" alt="PITALI" width="940" height="200" /></span></a>
      <a class="header-note" href="#universo">Sol e movimento <span aria-hidden="true">↗</span></a>
      <span class="mobile-header-note" aria-hidden="true">Beach &amp; fit</span>
    </header>

    <main>
      <ParallaxHero client:load />
      {featuredLookbook.enabled && <div id="fitwear"><LookbookSection client:visible title={featuredLookbook.heading} looks={featuredLookbook.looks} /></div>}
      <CatalogSection client:visible />
      <section class="next-chapter" id="manifesto" aria-labelledby="fitwear-title">
        <div class="chapter-topline"><span class="eyebrow">O movimento continua</span><span class="chapter-number">02</span></div>
        <div class="chapter-body">
          <p class="eyebrow chapter-label">Universo fitwear</p>
          <h2 id="fitwear-title">Seu ritmo.<br />Sua essência.</h2>
          <p class="chapter-copy">Há liberdade em ser você.<br />Em cada pausa. Em cada movimento.</p>
          <a class="coming-soon" href="https://www.instagram.com/pitali.oficial/" target="_blank" rel="noopener noreferrer">Conheça a Pitali no Instagram ↗</a>
        </div>
        <div class="brand-statement" id="universo"><span class="eyebrow">Pitali</span><p>Entre o sol e o movimento.</p><span>Beachwear &amp; fitwear</span></div>
      </section>
    </main>
    <MotionFooter client:visible />
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => { menu.open = false; });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
    </script>
  </body>
</html>
